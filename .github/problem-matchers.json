{
  "problemMatcher": [
    {
      "owner": "trellis-compiler",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^\\s*(\\S.*?):(\\d+):(\\d+): (?:fatal )?error: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "trellis-compiler-driver",
      "severity": "error",
      "pattern": [{ "regexp": "^\\s*([^\\s:]+: (?:fatal )?error: .*)$", "message": 1 }]
    },
    {
      "owner": "trellis-linker",
      "severity": "error",
      "pattern": [{ "regexp": "^\\s*(\\S.*: undefined reference to .*)$", "message": 1 }]
    },
    {
      "owner": "trellis-msvc",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^\\s*(\\S.*?)\\((\\d+)(?:,(\\d+))?\\)\\s?: (?:fatal )?error(?: ([A-Z]+\\d+))?\\s?: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "trellis-msvc-tool",
      "severity": "error",
      "pattern": [
        { "regexp": "^\\s*(\\S.*? : (?:fatal |Command line )?error [A-Z]+\\d+\\s?: .*)$", "message": 1 }
      ]
    },
    {
      "owner": "trellis-ninja",
      "severity": "error",
      "pattern": [{ "regexp": "^(FAILED: .*)$", "message": 1 }]
    },
    {
      "owner": "trellis-cmake",
      "severity": "error",
      "pattern": [
        { "regexp": "^CMake Error (?:at|in) (.+?)(?::(\\d+))?(?: \\(\\w+\\))?:$", "file": 1, "line": 2 },
        { "regexp": "^\\s+(\\S.*)$", "message": 1 }
      ]
    },
    {
      "owner": "trellis-cmake-plain",
      "severity": "error",
      "pattern": [{ "regexp": "^(CMake Error: .*)$", "message": 1 }]
    },
    {
      "owner": "trellis-ctest",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^\\s*\\d+ - (.+? \\((?:Failed|Timeout|Not Run|SEGFAULT|Subprocess aborted|Exception|ILLEGAL|INTERRUPT|NUMERICAL|OTHER_FAULT|BUS)\\))(?:\\s.*)?$",
          "message": 1
        }
      ]
    },
    {
      "owner": "trellis-ctest-none",
      "severity": "error",
      "pattern": [{ "regexp": "^(No tests were found!!!)$", "message": 1 }]
    },
    {
      "owner": "trellis-googletest",
      "severity": "error",
      "pattern": [
        { "regexp": "^\\s*(\\S.*?):(\\d+): Failure$", "file": 1, "line": 2 },
        { "regexp": "^(.*\\S.*)$", "message": 1 }
      ]
    },
    {
      "owner": "trellis-tools",
      "severity": "error",
      "pattern": [{ "regexp": "^\\s*(FAIL .*)$", "message": 1 }]
    },
    {
      "owner": "trellis-python",
      "severity": "error",
      "pattern": [{ "regexp": "^((?:FAIL|ERROR): test\\w* .*|\\w+(?:Error|Exception): .*)$", "message": 1 }]
    },
    {
      "owner": "trellis-sanitizer",
      "severity": "error",
      "pattern": [{ "regexp": "^(?:==\\d+==)?((?:ERROR|WARNING): \\w*Sanitizer: .*)$", "message": 1 }]
    },
    {
      "owner": "trellis-ubsan",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^\\s*(\\S.*?):(\\d+):(\\d+): runtime error: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}
